{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "B2B Sales Platform",
  "version": "1.0.0",
  "identifier": "com.b2bsales.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "B2B Sales Platform",
        "width": 1400,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "fa-IR"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
